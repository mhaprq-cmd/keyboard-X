<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reportIssuePageRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/reportIssueBackText"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="@string/action_back"
            android:textColor="@color/app_accent"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/action_back" />

        <TextView
            android:id="@+id/reportIssuePageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/report_issue_title"
            android:textColor="@color/app_text_primary"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reportIssueIntro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:text="@string/report_issue_intro"
            android:textColor="@color/app_text_secondary"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/app_card_background">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/report_name_label"
                android:textColor="@color/app_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/reportNameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp"
                android:hint="@string/report_name_hint"
                android:inputType="textPersonName|textCapWords"
                android:singleLine="true"
                android:minHeight="48dp"
                android:padding="12dp"
                android:textColor="@color/app_text_primary"
                android:textColorHint="@color/app_text_secondary"
                android:background="@drawable/app_card_background" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/report_email_label"
                android:textColor="@color/app_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/reportEmailInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp"
                android:hint="@string/report_email_hint"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:minHeight="48dp"
                android:padding="12dp"
                android:textColor="@color/app_text_primary"
                android:textColorHint="@color/app_text_secondary"
                android:background="@drawable/app_card_background" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/report_category_label"
                android:textColor="@color/app_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/reportCategorySpinner"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:contentDescription="@string/report_category_label"
                android:background="@drawable/app_card_background" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/report_description_label"
                android:textColor="@color/app_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/reportDescriptionInput"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:gravity="top|start"
                android:hint="@string/report_description_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="5"
                android:padding="12dp"
                android:scrollbars="vertical"
                android:textColor="@color/app_text_primary"
                android:textColorHint="@color/app_text_secondary"
                android:background="@drawable/app_card_background" />

            <TextView
                android:id="@+id/reportPrivacyNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="@string/report_privacy_note"
                android:textColor="@color/app_text_secondary"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />

            <Button
                android:id="@+id/reportSendButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="@string/report_send_button"
                android:textAllCaps="false"
                android:textSize="15sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
